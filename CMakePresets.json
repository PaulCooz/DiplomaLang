{
    "version": 8,
    "configurePresets": [
        {
            "name": "windows ninja",
            "displayName": "Windows ninja preset",
            "generator": "Ninja",
            "binaryDir": "${workspaceFolder}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "USE_LLVM": "ON",
                "WITH_TESTS": "OFF",
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl"
            }
        }
    ]
}